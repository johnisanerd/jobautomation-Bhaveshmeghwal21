# ── Azure AI Foundry (*.services.ai.azure.com hub endpoint) ──────────────────
# Paste the full "Target URI" from AI Foundry → Deployments → your model → endpoint details
# Example: https://hub.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview
AZURE_AI_ENDPOINT=

# API key from: AI Foundry hub → Keys and Endpoint
AZURE_AI_API_KEY=

# The model deployment name shown in AI Foundry → Deployments
AZURE_AI_DEPLOYMENT=kimi-k2.6

# API version — extracted automatically from the Target URI above; keep in sync
AZURE_AI_API_VERSION=2024-05-01-preview

# ── Apify ────────────────────────────────────────────────────────────────────
APIFY_API_KEY=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Sheets (Phase 5) ───────────────────────────────────────────────────
GOOGLE_SHEETS_ID=
GOOGLE_CREDENTIALS_PATH=pelagic-breaker-466911-g0-094bc9d0e183.json     #credentials.json


# ── Supabase (web deployment) ────────────────────────────────────────────────
# Project URL from: Supabase Dashboard → Settings → API
SUPABASE_URL=
# Service role secret key (backend only — never expose to frontend)
SUPABASE_SERVICE_KEY=
# Anon/public key (safe for frontend, read-only via RLS)
SUPABASE_ANON_KEY=
# Your Vercel frontend URL (for CORS whitelist on the FastAPI server)
FRONTEND_URL=

# ── Job Search Defaults ───────────────────────────────────────────────────────
DEFAULT_JOB_KEYWORD=data analyst intern
DEFAULT_LOCATION=remote
